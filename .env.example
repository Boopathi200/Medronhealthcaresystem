FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Outlook SMTP submission
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USERNAME=medronhealthcaresystems@outlook.com
SMTP_FROM=medronhealthcaresystems@outlook.com

# Use oauth2 for modern authentication. Use password only if SMTP AUTH
# and password/app-password authentication are enabled for this mailbox.
SMTP_AUTH_METHOD=oauth2
SMTP_PASSWORD=
SMTP_OAUTH_TENANT_ID=common
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
